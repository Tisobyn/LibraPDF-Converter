# Copy to .env and fill in. Run with: npm run start:env
PORT=3000
# Required. The server will not start without it. Use a long random string.
API_KEY=change-me

# Rate limit per caller, counted in Upstash Redis (free plan is enough). REQUIRED.
# Local testing without Redis: RATE_LIMIT_DISABLED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=500

# Optional
# SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# MAX_FILE_MB=50
# MAX_UPLOADS=10
# MAX_UPLOAD_MB_TOTAL=500
# MAX_CONCURRENT=2
# CONVERT_TIMEOUT_MS=60000   (try 90000 if you see 504 on big files)
